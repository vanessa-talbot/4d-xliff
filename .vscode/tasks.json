{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": "$tsc"
		},
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"problemMatcher": "$tsc-watch"
		},
		{
			"label": "Prepare sandbox",
			"type": "shell",
			"command": "sh scripts/sandbox.sh --keep",
			"dependsOn": "npm: compile",
			"problemMatcher": []
		},
		{
			"label": "Reset sandbox",
			"type": "shell",
			"command": "sh scripts/sandbox.sh",
			"dependsOn": "npm: compile",
			"problemMatcher": []
		}
	]
}
